# ============================================
# SISTEMA BIOMÉTRICO - VARIABLES DE ENTORNO
# Copia este archivo como .env y edita los valores
# ============================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biometric_db
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Railway provee esta variable automáticamente:
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Seguridad
SECRET_KEY=genera-una-clave-secreta-larga-y-aleatoria

# CORS (separar por comas para múltiples orígenes)
# En producción: https://checkin.chaskibots.com,https://admin.chaskibots.com
CORS_ORIGINS=*

# Reconocimiento facial
SIMILARITY_THRESHOLD=0.45
MIN_FACE_QUALITY=40.0

# GPS
MAX_DISTANCE_METERS=200
